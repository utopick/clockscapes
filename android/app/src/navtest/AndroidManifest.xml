<?xml version="1.0" encoding="utf-8"?>
<!-- Test build only: Clockscapes also says it is a navigation app, which Android Auto always lists when
     sideloaded. The Play Store would not accept a clock as a navigation app, so this never ships. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="androidx.car.app.NAVIGATION_TEMPLATES" />
    <application>
        <service android:name=".CarService" android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
            </intent-filter>
        </service>
    </application>
</manifest>
